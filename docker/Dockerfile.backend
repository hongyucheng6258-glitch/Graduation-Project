FROM maven:3.9-eclipse-temurin-17 AS build

WORKDIR /build
COPY web/backend/pom.xml ./pom.xml
RUN mvn -B -DskipTests dependency:go-offline
COPY web/backend/src ./src
RUN mvn -B -DskipTests package
COPY docker/HealthProbe.java /tmp/HealthProbe.java
RUN javac --release 17 -d /health /tmp/HealthProbe.java

FROM eclipse-temurin:17-jre

# 构建版本信息：docker compose build --build-arg BUILD_VERSION=v1.2.0 传入
ARG BUILD_VERSION=dev
ENV APP_VERSION=$BUILD_VERSION

WORKDIR /app
COPY --from=build /build/target/platform-server.jar ./app.jar
COPY --from=build /health ./health
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
