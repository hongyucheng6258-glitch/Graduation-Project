# Docker Compose 环境变量示例（请复制为 .env 后按需修改）
# Required secrets must be set locally; Compose rejects missing or empty values.
# 生成长随机密钥示例：openssl rand -hex 32
MYSQL_ROOT_PASSWORD=
MYSQL_DB=ai_campus_platform
# 必填：Redis 密码，服务端 requirepass 与后端客户端必须一致
REDIS_PASSWORD=
# 虚拟线程默认开启，设为 false 可切回平台线程。
SPRING_THREADS_VIRTUAL_ENABLED=true
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
# 必填：JWT 签名密钥（>=32 字符随机串，不得使用仓库默认值）
# Sa-Token 不需要 JWT 签名密钥
# 必填：签到二维码 HMAC 密钥（>=16 字符随机串）
SIGNIN_SECRET=
TRUSTED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:15173,http://localhost:15174,http://127.0.0.1:15173,http://127.0.0.1:15174

# Host ports; 5173/5174 may be reserved by Windows.
STUDENT_PORT=15173
ADMIN_PORT=15174
BACKEND_PORT=8080

# ===== AI 检索服务（Python 第二后端，可选）=====
# 只有显式叠加 docker-compose.ai-service.yml 时才需要。默认 local：后端仍走原实现。
# 可选值：local / python
CAMPUS_AGENT_RAG_PROVIDER=local
# Python 检索服务异常时是否回退本地实现（建议保持 true）
CAMPUS_AGENT_RAG_FALLBACK=true
# 服务间鉴权令牌；启用 python 时必填，建议 openssl rand -hex 32
CAMPUS_AI_SERVICE_TOKEN=
# Python 侧使用的独立向量集合，与后端现有集合隔离
CAMPUS_AI_RAG_COLLECTION=campus_bge_small_onnx_v1_py

